{
    "name": "GitHub Copilot Dev Kit Lab",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {
            "version": "2.48"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "none",
            "dotnetRuntimeVersions": "10.0",
            "aspNetCoreRuntimeVersions": "10.0"
        },
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        },
        "ghcr.io/devcontainers/features/node:2.0.0": {
            "version": "latest"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "GitHub.copilot",
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/setup-sql-server.sh",
    "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && npm install -g @github/specify",
    "hostRequirements": {
        "memory": "8gb",
        "cpus": 4
    }
}
